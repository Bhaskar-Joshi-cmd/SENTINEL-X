# ==========================================================================
# SENTINEL-X / CascadeGuard — backend environment template
# ==========================================================================
# Copy this file to server/.env and fill in real values.
# server/.env is gitignored. NEVER commit real credentials.
#
# Values are read by server/app/core/config.py (pydantic-settings).
# ==========================================================================

# --- Required --------------------------------------------------------------

# Supabase project URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public/anon key. Used to verify Supabase Auth bearer tokens.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service-role key. This BYPASSES Row Level Security and has full
# read/write access to the database. Backend use only — never expose it
# to the frontend and never commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Optional --------------------------------------------------------------

# Shared secret that sensor gateways must send in the x-sensor-key header
# when posting to /api/sensors/readings. Leave empty to disable the check
# (development only — never do this in a deployed environment).
SENSOR_INGEST_KEY=

# Seconds to pause between replay steps during demo replay.
REPLAY_STEP_DELAY_SECONDS=2

# Comma-separated list of browser origins permitted to call the API.
# Add your deployed frontend origin here in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

