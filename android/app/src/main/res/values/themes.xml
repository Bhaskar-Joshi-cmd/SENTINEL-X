<resources>
    <!-- Light theme: readable in daylight on a low-cost phone. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/sx_page</item>
        <item name="android:colorAccent">@color/sx_brand</item>
        <item name="colorAccent">@color/sx_brand</item>
        <item name="android:navigationBarColor">@color/sx_surface</item>
        <item name="android:statusBarColor">@color/sx_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/sx_text</item>
        <item name="android:textColorSecondary">@color/sx_text_muted</item>
    </style>
</resources>
