<?xml version="1.0" encoding="utf-8"?>
<!--
  SENTINEL-X light layout.
  All @+id values are unchanged from the previous layout so MainActivity's
  findViewById calls keep working.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sx_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="6dp"
                android:layout_height="34dp"
                android:background="@color/sx_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/sx_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_tagline"
                    android:textColor="@color/sx_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/userText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/sx_card"
            android:padding="14dp"
            android:textColor="@color/sx_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="VIEWING AS"
            android:textColor="@color/sx_text_faint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <Spinner
            android:id="@+id/roleSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/sx_card"
            android:padding="10dp"
            android:contentDescription="Select demo role" />

        <TextView
            android:id="@+id/roleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/sx_brand"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/workspaceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/sx_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/sx_card"
            android:padding="14dp"
            android:text="Relay is stopped"
            android:textColor="@color/sx_text_muted"
            android:textSize="14sp" />

        <!-- Role workspace content is injected here by MainActivity -->
        <LinearLayout
            android:id="@+id/roleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="DATA CONNECTION"
            android:textColor="@color/sx_text_faint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <EditText
            android:id="@+id/dashboardUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/sx_card"
            android:padding="14dp"
            android:hint="SENTINEL-X API URL"
            android:inputType="textUri"
            android:singleLine="true"
            android:text="Configured in local.properties"
            android:textColor="@color/sx_text"
            android:textColorHint="@color/sx_text_faint" />

        <TextView
            android:id="@+id/dashboardStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp"
            android:text="Not connected"
            android:textColor="@color/sx_text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/dashboardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/sx_button_secondary"
            android:text="Refresh data"
            android:textAllCaps="false"
            android:textColor="@color/sx_brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="OFFLINE RELAY"
            android:textColor="@color/sx_text_faint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Works without internet. Alerts hop phone to phone over Bluetooth and Wi-Fi."
            android:textColor="@color/sx_text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/relayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/sx_button_secondary"
            android:text="Start nearby relay"
            android:textAllCaps="false"
            android:textColor="@color/sx_brand" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/sx_button_primary"
            android:text="Send relay alert"
            android:textAllCaps="false"
            android:textColor="@color/sx_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="RECEIVED ALERTS"
            android:textColor="@color/sx_text_faint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/alertsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/sx_card"
            android:padding="14dp"
            android:text="No alerts received yet."
            android:textColor="@color/sx_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Demo: install on 3 phones, start the relay on all of them, then send from the first phone. Keep internet off, but leave Bluetooth and Wi-Fi on."
            android:textColor="@color/sx_text_faint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>


