# ==========================================================================
# SENTINEL-X / CascadeGuard — environment template
# ==========================================================================
# Copy to .env (frontend, repo root) and fill in real values.
# NEVER commit a filled-in .env. The patterns below are ignored by git.
# ==========================================================================

# --------------------------------------------------------------------------
# Frontend (Vite) — only variables prefixed with VITE_ reach the browser.
# The backend base URL. Leave unset for local development: the app defaults
# to http://127.0.0.1:8000/api on localhost and /api elsewhere.
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Vercel / same-origin deployment:
# VITE_API_BASE_URL=/api

# --------------------------------------------------------------------------
# Backend (FastAPI) — create server/.env from these values.
# All three Supabase values are required or the backend will not start.
# --------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service-role key bypasses Row Level Security. Backend use ONLY.
# Never expose this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional -----------------------------------------------------------------

# Shared secret required in the x-sensor-key header for sensor ingestion.
# Leave empty to disable the check (development only).
SENSOR_INGEST_KEY=

# Seconds to pause between replay steps (demo pacing).
REPLAY_STEP_DELAY_SECONDS=2.0

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

