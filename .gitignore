# =========================================================
# ENVIRONMENT / SECRETS
# =========================================================

# Ignore environment files in root and all subdirectories
**/.env
**/.env.*

# Keep example environment files tracked
!.env.example
!**/.env.example


# =========================================================
# FRONTEND / NODE
# =========================================================

node_modules/
**/node_modules/

dist/
**/dist/

# Vite / frontend caches
.vite/
**/.vite/

# Coverage output
coverage/
**/coverage/


# =========================================================
# PYTHON BACKEND
# =========================================================

# Python virtual environments
.venv/
**/.venv/
venv/
**/venv/

# Python cache / compiled files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Python tooling caches
.pytest_cache/
**/.pytest_cache/

# Logs
*.log
**/*.log


# =========================================================
# ANDROID / GRADLE
# =========================================================

.gradle/
**/.gradle/

**/build/
local.properties
**/local.properties

# Android Studio generated files
.idea/
**/.idea/
*.iml
**/*.iml

# Kotlin generated files
.kotlin/
**/.kotlin/


# =========================================================
# IDE / OS FILES
# =========================================================

# macOS
.DS_Store
**/.DS_Store

# VS Code
.vscode/
**/.vscode/

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Editor / agent "save a copy before editing" backups
*.before-*
*.before
*.orig
*.rej

# Ad-hoc local diagnostic scripts (not part of the application)
server/probe_*.py
scripts/probe_*.py


# =========================================================
# PROJECT-SPECIFIC LOCAL FILES
# =========================================================

# Backup files created during development
*.backup
*.bak

# Committed Windows build output (from a Windows dev machine).
# Remove from the index once with: git rm -r --cached 'android/C:'